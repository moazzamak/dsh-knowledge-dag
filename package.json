{
  "name": "dsh-knowledge-dag",
  "version": "0.6.0",
  "description": "Show a research graph in the DeepSeek Harness: the questions, what they derive from, what they rest on and what they ended in, with a plain-English page per node. Generic over any node store, so the model's knowledge base can be a second source.",
  "author": "Moazzam Abdullah Khan (https://github.com/moazzamak)",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "knowledge",
    "graph",
    "dag",
    "research"
  ],
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.cjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "client.cjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moazzamak/dsh-knowledge-dag.git"
  },
  "homepage": "https://github.com/moazzamak/dsh-knowledge-dag#readme",
  "bugs": {
    "url": "https://github.com/moazzamak/dsh-knowledge-dag/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}